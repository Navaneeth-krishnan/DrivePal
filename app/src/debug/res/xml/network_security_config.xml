<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allows plain HTTP to any address, so a local Ollama (on the emulator host 10.0.2.2, through
     `adb reverse` as localhost, or on a laptop on your Wi-Fi) can be tried. The app itself still refuses to send an
     API key over plain HTTP, and release builds have no such exception. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
