<?xml version='1.0' encoding='UTF-8'?>
<!--
  Malayalam names: Pullad and Kerala are mapped with their name in Malayalam script, Kumbanad and Tamil Nadu with
  a name:ml tag, the rest with none.
  A tiny made-up extract for the Region pack builder (scripts/build_region_pack.py). Boundaries are boxes:
  India 76-79 E, 8-10 N; Kerala (Q1186) 76-77 E with a hole at 76.4-76.5 E, 9.0-9.1 N that is Puducherry (Mahé);
  Tamil Nadu 77-78 E next door; Andhra Pradesh 78.5-79 E, which does not touch Kerala.
  Build the fixture pack (kerala-fixture.drivepal) with scripts/build_region_pack.py, giving this file,
  the Wikidata id Q1186 and that output; the exact command is in scripts/build_fixture_pack.sh.
-->
<osm version="0.6" generator="hand">
  <!-- Boundary corners -->
  <node id="1001" lat="8.0" lon="76.0"/>
  <node id="1002" lat="8.0" lon="77.0"/>
  <node id="1003" lat="10.0" lon="77.0"/>
  <node id="1004" lat="10.0" lon="76.0"/>
  <node id="1011" lat="9.0" lon="76.4"/>
  <node id="1012" lat="9.0" lon="76.5"/>
  <node id="1013" lat="9.1" lon="76.5"/>
  <node id="1014" lat="9.1" lon="76.4"/>
  <node id="1021" lat="8.0" lon="78.0"/>
  <node id="1022" lat="10.0" lon="78.0"/>
  <node id="1031" lat="8.0" lon="79.0"/>
  <node id="1032" lat="10.0" lon="79.0"/>
  <node id="1041" lat="8.0" lon="78.5"/>
  <node id="1042" lat="10.0" lon="78.5"/>
  <!-- Kattode, mapped as an area: a square around 9.362 N, 76.672 E -->
  <node id="1051" lat="9.361" lon="76.671"/>
  <node id="1052" lat="9.361" lon="76.673"/>
  <node id="1053" lat="9.363" lon="76.673"/>
  <node id="1054" lat="9.363" lon="76.671"/>

  <!-- Places in Kerala -->
  <node id="11" lat="9.3555" lon="76.6761">
    <tag k="place" v="village"/>
    <tag k="name" v="പുല്ലാട്"/>
    <tag k="name:en" v="Pullad"/>
  </node>
  <node id="12" lat="9.3601" lon="76.6830">
    <tag k="place" v="locality"/>
    <tag k="name" v="Muttumon"/>
  </node>
  <node id="13" lat="9.3640" lon="76.6900">
    <tag k="highway" v="motorway_junction"/>
    <tag k="name" v="Kumbanad"/>
    <tag k="name:ml" v="കുമ്പനാട്"/>
  </node>
  <node id="14" lat="9.5355" lon="76.6761">
    <tag k="place" v="town"/>
    <tag k="name" v="Kozhencherry"/>
    <tag k="wikipedia" v="en:Kozhencherry"/>
    <tag k="wikidata" v="Q2085583"/>
  </node>
  <node id="15" lat="9.3490" lon="76.6750">
    <tag k="place" v="suburb"/>
    <tag k="name" v="Thottabhagam"/>
  </node>
  <!-- Left out: no name; not a kind of place the pack holds; a junction with no name -->
  <node id="16" lat="9.3580" lon="76.6790">
    <tag k="place" v="hamlet"/>
  </node>
  <node id="17" lat="9.3585" lon="76.6795">
    <tag k="place" v="isolated_dwelling"/>
    <tag k="name" v="Puthenveedu"/>
  </node>
  <node id="20" lat="9.3590" lon="76.6800">
    <tag k="highway" v="motorway_junction"/>
  </node>

  <!-- Places in Tamil Nadu: one about 2 km beyond the border (kept), one 50 km beyond it (left out) -->
  <node id="18" lat="9.5" lon="77.02">
    <tag k="place" v="town"/>
    <tag k="name" v="Bodinayakanur"/>
  </node>
  <node id="19" lat="9.5" lon="77.5">
    <tag k="place" v="city"/>
    <tag k="name" v="Theni"/>
  </node>

  <way id="21">
